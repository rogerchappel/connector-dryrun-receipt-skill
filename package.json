{
  "name": "connector-dryrun-receipt-skill",
  "version": "0.1.0",
  "description": "Local-first skill for rendering connector dry-run plans into reviewable approval receipts.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "connector-dryrun-receipt": "bin/connector-dryrun-receipt.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/connector-dryrun-receipt.js && node --check src/index.js",
    "smoke": "node bin/connector-dryrun-receipt.js render fixtures/receipt.valid.json --format markdown"
  },
  "keywords": [
    "agent",
    "skill",
    "connector",
    "dry-run",
    "audit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "fixtures",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-dryrun-receipt-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-dryrun-receipt-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-dryrun-receipt-skill#readme"
